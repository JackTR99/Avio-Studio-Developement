# AVIO Studio — Supabase ayarları
# Bu dosyayı .env olarak kopyala ve doldur.
#
# BOŞ BIRAKILIRSA: uygulama TASLAK MODUNDA açılır — giriş atlanır,
# ekranlar sahte verilerle çalışır. Geliştirme için bu yeterli.
#
# DOLDURULURSA: giriş ekranı devreye girer, gerçek Supabase'e bağlanır.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
